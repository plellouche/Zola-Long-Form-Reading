# =============================================================================
# Copy this file to .env and fill in real values. .env is gitignored.
# =============================================================================

# ---------- apps/web (Next.js) ----------
# Exposed to the browser — must be safe to publish.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 13 invite-only gate on /signup.
# Set to 'true' to require a code; leave unset / 'false' to allow any signup.
NEXT_PUBLIC_INVITE_REQUIRED=true
# Comma-separated invite codes (server-only — never NEXT_PUBLIC_*).
# Codes are doormat security: sharing a code lets anyone sign up. Use 3-word
# phrases so they're easy to share verbally.
ZOLA_INVITE_CODES=

# ---------- services/api (FastAPI) ----------
# Server-side only. Never expose to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=...                          # legacy JWT secret from Supabase dashboard → API settings
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---------- dev convenience ----------
# Comma-separated list of usernames or user IDs to treat as admin until role column is wired (Phase 1+).
ADMIN_BOOTSTRAP_EMAILS=

# ---------- Sentry (Phase 17 light, optional) ----------
# Leave blank locally — Sentry's init is a no-op when DSN is unset.
# Production: create a Sentry org/project, copy the DSN, set it on both
# Render (SENTRY_DSN) and Vercel (NEXT_PUBLIC_SENTRY_DSN).
#
# NEXT_PUBLIC_SENTRY_DSN ships to the browser; same DSN as the backend.
# SENTRY_DSN is the FastAPI-side variable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional: only needed for source map upload (better stack traces in Sentry).
# Get from Sentry → Settings → Account → Auth Tokens, plus your org/project slug.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
